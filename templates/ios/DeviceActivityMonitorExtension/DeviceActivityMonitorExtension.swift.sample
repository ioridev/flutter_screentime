import DeviceActivity
import ManagedSettings

final class DeviceActivityMonitorExtension: DeviceActivityMonitor {
  private let store = ManagedSettingsStore()

  override func intervalDidStart(for activity: DeviceActivityName) {
    let defaults = UserDefaults(suiteName: "group.your.app")
    let isBlockingEnabled = defaults?.bool(forKey: "flutter_screentime.blockingEnabled") ?? false
    guard isBlockingEnabled else {
      return
    }

    // Load your stored FamilyActivitySelection here and re-apply it if needed.
    // The plugin persists the encoded selection under:
    // "flutter_screentime.blockedSelection"
  }

  override func intervalDidEnd(for activity: DeviceActivityName) {
    store.clearAllSettings()
  }
}
